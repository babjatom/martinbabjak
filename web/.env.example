# Postgres (required for /api route handlers)
DATABASE_URL=postgresql://user:pass@localhost:5432/booking

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Web application client)
# Redirect URIs: http://localhost:3000/api/auth/callback/google
#                 https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Gmail addresses allowed to use /bookings and admin APIs
ADMIN_EMAILS=you@gmail.com

# On Vercel, set AUTH_TRUST_HOST=true (or rely on VERCEL_URL) so OAuth callbacks work
# AUTH_TRUST_HOST=true
